PORT=5000
MONGO_URI="mongodb://<username>:<password>@<host>:<port>/?ssl=true&replicaSet=<replicaSet>&authSource=admin&appName=<appName>"
JWT_SECRET="<replace-with-strong-secret>"
JWT_EXPIRE=7d
GEMINI_API_KEY="<replace-with-gemini-api-key>"
GEMINI_MODEL="gemini-2.0-flash"
NODE_ENV=development

# CORS — set to your frontend's deployed URL. Required in production;
# the server will refuse to start if NODE_ENV=production and this is missing
# or still points to localhost. In dev, the server falls back to '*' / localhost.
CLIENT_URL=https://your-frontend-domain.com
